# Code style for Kotlin (ktlint 1.8, Android Studio style). Checked with: java -jar ktlint.jar "app/src/**/*.kt"
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
ktlint_code_style = android_studio
max_line_length = 160
# Composables are PascalCase by Compose convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Page scripts are long one-line strings; wrapping them would change nothing but readability of diffs.
ktlint_standard_max-line-length = disabled
