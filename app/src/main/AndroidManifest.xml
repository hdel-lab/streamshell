<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Load websites and the filter lists. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Show an honest offline state instead of a generic WebView error. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Background playback: a media foreground service keeps audio running with a notification and controls. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+: lets the playback notification (with its controls) appear; asked once, when background playback first starts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android Auto (unofficial use, see docs/ANDROID_AUTO.md): a drawing surface on the car screen, and the car's
         speed so the picture shows only while parked. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" />
    <uses-feature android:name="android.software.picture_in_picture" android:required="false" />

    <application
        android:name=".StreamShellApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.StreamShell"
        android:usesCleartextTraffic="false">

        <!--
            configChanges lists everything a foldable emits when folding/unfolding, rotating, resizing in
            split-screen or changing density, so the Activity (and the WebViews it hosts) is not recreated.
            resizeableActivity is required for split-screen and for proper large-screen behavior.
        -->
        <activity
            android:name=".MainActivity"
            android:supportsPictureInPicture="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|layoutDirection|colorMode|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- StreamShell can be chosen to open web links from other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
            </intent-filter>
            <!-- Launcher shortcuts (long-press the icon): YouTube, Search, Continue watching. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="2" />
        <!-- Exported because Android Auto binds to it; who may connect is checked in createHostValidator()
             (only Google's Android Auto / Automotive hosts in release builds). -->
        <service
            android:name=".car.StreamShellCarService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- Home-screen widget "Continue watching" (exported: the launcher sends it its updates). -->
        <receiver
            android:name=".widget.ContinueWidget"
            android:exported="true"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_continue_info" />
        </receiver>

        <service
            android:name=".core.media.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
